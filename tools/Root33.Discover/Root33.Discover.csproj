<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Root33.Discover</RootNamespace>
    <AssemblyName>Root33.Discover</AssemblyName>
    <!-- Builds run under a shared flock (see src/Directory.Build.props, which does not reach tools/): compile in-process so
         no compiler server inherits the lock. -->
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Root33.Discover.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reads assemblies as metadata only: nothing in them runs (no static constructors, no module initialisers). -->
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>

</Project>
