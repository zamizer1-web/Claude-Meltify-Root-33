<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 loads under BepInEx 5 (Mono), BepInEx 6 IL2CPP and MelonLoader alike. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <!-- 'annotations': the sheets' signatures use 'string?' (read.relic-type, hook.bot-decision, state.lune.stain-armed...).
         Under 'disable' every one of them is warning CS8632, which TreatWarningsAsErrors turns into a build error.
         'annotations' accepts the '?' and still reports no nullability warnings, so the rest of the code is unchanged. -->
    <Nullable>annotations</Nullable>
    <!-- CS8669: the generator marks its files '// <auto-generated>', which switches the nullable context off inside them,
         so each 'string?' there is reported as an ignored annotation. Harmless: the '?' is only documentation. -->
    <NoWarn>$(NoWarn);CS8669</NoWarn>
    <RootNamespace>Root33.Core</RootNamespace>
    <AssemblyName>Root33.Core</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Root33.Core.Tests" />
  </ItemGroup>

  <!--
    Build-time workaround for a tools/gen_cs.py bug (tools/ is not ours to edit):
    the generator names each <Sheet>Def constructor parameter after its sheet column in camelCase, and three columns are
    C# keywords (win_conditions.params, overlays.public, options.default), so Generated/Sheets.g.cs does not parse.
    Generated/Sheets.g.cs stays exactly what the generator wrote; the build compiles a copy in obj/ in which every
    constructor parameter is written verbatim-escaped ('@params'), which is legal C# for any identifier.
    The rewrite is idempotent, so it keeps working (and becomes a plain copy) once the generator escapes the names itself.
    Delete this block once gen_cs.py emits valid C#.
  -->
  <ItemGroup>
    <Compile Remove="Generated\Sheets.g.cs" />
    <None Include="Generated\Sheets.g.cs" />
  </ItemGroup>

  <UsingTask TaskName="Root33EscapeCtorParams" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var ctor = new Regex(@"^(\s+public \w+Def\()(.*)(\)\s*)$");
        var param = new Regex(@"(?<=\S )([A-Za-z_]\w*)(?=, |$)");
        var assign = new Regex(@"^(\s+[A-Z]\w* = )([a-z]\w*);(\s*)$");
        var lines = File.ReadAllLines(Source);
        for (var i = 0; i < lines.Length; i++)
        {
            var m = ctor.Match(lines[i]);
            if (m.Success)
            {
                lines[i] = m.Groups[1].Value + param.Replace(m.Groups[2].Value, "@$1") + m.Groups[3].Value;
                continue;
            }
            lines[i] = assign.Replace(lines[i], "$1@$2;$3");
        }
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        var text = string.Join("\n", lines) + "\n";
        if (!File.Exists(Destination) || File.ReadAllText(Destination) != text) File.WriteAllText(Destination, text);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="Root33FixGeneratedSheets" BeforeTargets="CoreCompile" Condition="Exists('Generated\Sheets.g.cs')">
    <Root33EscapeCtorParams Source="$(MSBuildProjectDirectory)\Generated\Sheets.g.cs" Destination="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)Sheets.escaped.g.cs" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)Sheets.escaped.g.cs" />
    </ItemGroup>
  </Target>

</Project>
