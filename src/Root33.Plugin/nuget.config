<?xml version="1.0" encoding="utf-8"?>
<!-- Packages for the cloud compile check (-p:NoUnity=true): BepInEx, Il2CppInterop and the Unity reference assemblies come
     from BepInEx's own feed; HarmonyX and the rest from nuget.org. The PC build references BepInEx from the dev copy. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="BepInEx" value="https://nuget.bepinex.dev/v3/index.json" />
  </packageSources>
</configuration>
